import java.util.Scanner;

public class CommandGame {
    public static void main(String[]args) throws InterruptedException {
        int playerHp = 100;
        int enemyHp = 50;

        System.out.println("勇者 HP:" + playerHp);
        System.out.println("スライム HP:" + enemyHp);

        Scanner scanner = new Scanner(System.in);

        // whileの処理
        while (enemyHp > 0 && playerHp > 0) {

            //コマンドの表示
            System.out.println("1.たたかう");
            System.out.println("2.にげる");
            System.out.println("3.腹踊りをする");
            System.out.println("コマンドを入力");

            //ターン入力
            int command = scanner.nextInt();

            // 勇者の処理
            if (command == 1) {
                enemyHp = enemyHp - 10;
                System.out.println("勇者はスライムを攻撃した！");
                Thread.sleep(2000);
                System.out.println("スライムに10ダメージ！");
                Thread.sleep(2000);
                System.out.println("スライム HP:" + enemyHp);
                Thread.sleep(2000);

            } else if (command == 2) {
                System.out.println("勇者は逃げ出した！");
                Thread.sleep(2000);
                System.out.println("しかし、逃げられなかった！");
                Thread.sleep(2000);

            } else if (command == 3) {
                System.out.println("勇者は腹踊りをした！");
                Thread.sleep(2000);
                System.out.println("しかし、何も起こらなかった！");
                Thread.sleep(2000);
            }

            // スライムの処理
            if (enemyHp > 0) {
                playerHp = playerHp - 5;
                System.out.println("スライムの攻撃！");
                Thread.sleep(2000);
                System.out.println("勇者に５ダメージ！");
                Thread.sleep(2000);
                System.out.println("勇者 Hp:" + playerHp);
                Thread.sleep(2000);
            }

        }
        if (enemyHp <= 0 && playerHp > 0) {
            System.out.println("スライムを倒した！");
            Thread.sleep(2000);
            System.out.println("勝利！");
        } else if (playerHp <= 0) {
            System.out.println("勇者は力尽きた...");
            Thread.sleep(2000);
            System.out.println("ゲームオーバー！");
        }
    }
}
