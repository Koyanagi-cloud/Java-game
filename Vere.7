import java.util.Scanner;
import java.util.Random;
import java.util.ArrayList;

public class CommandGame {
    public static void main(String[]args) throws InterruptedException {

        Scanner scanner = new Scanner(System.in);
        System.out.println();
        System.out.println("==============================");
        System.out.println("         COMMAND GAME         ");
        System.out.println("==============================");
        System.out.println();
        System.out.println("1.ゲームスタート");
        System.out.println("2.ゲーム終了");
        System.out.println();
        System.out.println("コマンドを入力");

        int titleCommand = scanner.nextInt();

        if (titleCommand == 1) {
            System.out.println();
            System.out.println("勇者は旅をしている...");
            Thread.sleep(1500);
            System.out.println("スライムが現れた！");
            Thread.sleep(1500);

        } else if (titleCommand == 2) {
            System.out.println("ゲームを終了します。");
            return;
        }

        int playerHp = 100;
        int playerMp = 30;
        int herbCount = 3;
        int enemyHp = 80;

        boolean escaped = false;

        boolean enhanced = false;
        int enhanceTurns = 0;

        boolean defending = false;

        boolean charged = false;

        boolean weakened = false;
        int weakenedTurns = 0;

        boolean burned = false;
        int burnTurns = 0;
        int burnDamage = 0;

        Random random = new Random();

        // whileの処理
        while (enemyHp > 0 && playerHp > 0 && !escaped) {

            boolean commandSelected = false;
            while (!commandSelected) {

                System.out.println();
                System.out.println("-------------------");
                System.out.println("勇者　　　HP:" + playerHp + "/100");
                System.out.println("　　　　　MP:" + playerMp + "/30");
                System.out.println();
                System.out.println("スライム　HP:" + enemyHp + "/80");
                System.out.println("-------------------");

                //コマンドの表示

                System.out.println();
                System.out.println("1.たたかう");
                System.out.println("2.にげる");
                System.out.println("3.まもる");
                System.out.println("4.アイテム");
                System.out.println();
                System.out.println("コマンドを入力");


                //ターン入力
                int command = scanner.nextInt();

                System.out.println();

                // 勇者の処理
                if (command == 1) {

                    System.out.println("行動を選択してください");
                    System.out.println("1.こうげき");
                    System.out.println("2.まほう");
                    System.out.println("3.とくぎ");
                    System.out.println("4.戻る");
                    System.out.println();
                    System.out.println("コマンドを入力");

                    int battleCommand = scanner.nextInt();

                    if (battleCommand == 1) {

                        int damage;

                        System.out.println();
                        System.out.println("勇者はスライムを攻撃した！");
                        Thread.sleep(1500);

                        if (random.nextInt(4) == 0) {
                            damage = 25;
                            System.out.println("会心の一撃！");
                            Thread.sleep(1500);

                        } else {
                            damage = random.nextInt(8, 16);
                        }
                        if (enhanced) {
                            damage = (int) Math.round(damage * 1.5);
                        }
                        if (weakened) {
                            damage = (int) Math.round(damage * 0.7);
                        }


                        enemyHp = Math.max(0, enemyHp - damage);

                        System.out.println("スライムに" + damage + "ダメージ！");
                        Thread.sleep(1500);
                        System.out.println("スライム HP:" + enemyHp);
                        Thread.sleep(1500);

                        commandSelected = true;

                    } else if (battleCommand == 2) {

                        System.out.println("魔法を選択してください");
                        System.out.println("1.ファイヤー　MP10");
                        System.out.println("2.身体強化　　MP10");
                        System.out.println("3.戻る");
                        System.out.println();
                        System.out.println("コマンドを入力");


                        int magicCommand = scanner.nextInt();

                        if (magicCommand == 1) {
                            if (playerMp >= 10) {
                                playerMp = playerMp - 10;

                                System.out.println();
                                System.out.println("勇者はファイヤーを唱えた！");
                                Thread.sleep(1500);

                                int damage = random.nextInt(20, 26);
                                enemyHp = Math.max(0, enemyHp - damage);

                                System.out.println("スライムに" + damage + "ダメージ！");
                                Thread.sleep(1500);
                                if (random.nextInt(10) < 3) {
                                    burned = true;
                                    burnTurns = random.nextInt(2,5);
                                    burnDamage = random.nextInt(2,6);

                                    System.out.println("スライムはやけどを負った！");
                                    Thread.sleep(1500);

                                }

                                System.out.println("スライム HP:" + enemyHp);
                                Thread.sleep(1500);

                                commandSelected = true;

                            } else {
                                System.out.println();
                                System.out.println("MPが足りないッ！");
                                Thread.sleep(1500);
                            }
                        } else if (magicCommand == 2) {
                            if (playerMp >= 10 && !enhanced) {
                                playerMp = playerMp - 10;
                                enhanced = true;
                                enhanceTurns = 4;
                                System.out.println();
                                System.out.println("勇者は身体強化を使った！");
                                Thread.sleep(1500);
                                System.out.println("3ターンの間、通常攻撃のダメージが1.5倍になる！");
                                Thread.sleep(1500);

                                commandSelected = true;

                            } else if (enhanced) {
                                System.out.println();
                                System.out.println("すでに身体強化がかかっているッ！");
                                Thread.sleep(1500);
                            } else {
                                System.out.println();
                                System.out.println("MPが足りないッ！");
                                Thread.sleep(1500);
                            }
                        } else if (magicCommand == 3) {
                            continue;
                        }
                    } else if (battleCommand == 3) {
                        System.out.println();
                        System.out.println("勇者は腹踊りをした！");
                        Thread.sleep(1500);

                        if (random.nextInt(5) == 0) {
                            enemyHp = Math.max(0, enemyHp - 9999);

                            System.out.println("スライムは腹を抱えて笑った！");
                            Thread.sleep(1500);
                            System.out.println("スライムに9999ダメージ！");
                            Thread.sleep(1500);
                        } else {
                            System.out.println("しかし、何も起こらなかった！");
                            Thread.sleep(1500);
                        }

                        commandSelected = true;

                    } else if (battleCommand == 4) {
                        continue;
                    }

                } else if (command == 2) {
                    System.out.println("勇者は逃げ出した！");
                    Thread.sleep(1500);

                    if (random.nextInt(2) == 0) {
                        escaped = true;

                        System.out.println("勇者は逃げ切った！");
                        Thread.sleep(1500);

                        commandSelected = true;

                    } else {
                        System.out.println("しかし、逃げられなかった！");
                        Thread.sleep(1500);

                        commandSelected = true;
                    }

                } else if (command == 3) {
                    System.out.println("勇者は身を固めた！");
                    Thread.sleep(1500);

                    defending = true;
                    commandSelected = true;

                } else if (command == 4) {
                    System.out.println("アイテムを選択してください");
                     if (herbCount > 0) {
                         System.out.println("1.薬草 ✕ " + herbCount);
                         System.out.println("2.戻る");
                         System.out.println();
                         System.out.println("コマンドを選択");
                     } else {
                         System.out.println("1.戻る");
                         System.out.println();
                         System.out.println("コマンドを選択");
                     }

                      int itemCommand = scanner.nextInt();


                      if (herbCount > 0 && itemCommand == 1 ) {

                          if (playerHp == 100) {
                              System.out.println();
                              System.out.println("勇者のHPは満タンだ！");
                              Thread.sleep(1500);
                              continue;

                          } else {
                              int beforeHp = playerHp;

                              playerHp = Math.min(100, playerHp + 20);
                              herbCount--;

                              int healedHp = playerHp - beforeHp;

                              System.out.println();
                              System.out.println("勇者は薬草を使った！");
                              Thread.sleep(1500);

                              System.out.println("勇者のHPが" + healedHp + "回復した！");
                              Thread.sleep(1500);

                              System.out.println("勇者 HP:" + playerHp);
                              Thread.sleep(1500);

                              commandSelected = true;

                          }

                      } else if (herbCount > 0 && itemCommand == 2) {
                          continue;

                      } else if (herbCount == 0 && itemCommand == 1) {
                          continue;
                      }
                }
            }
                // スライムの処理
                if (!escaped && enemyHp > 0) {

                    System.out.println();

                    ArrayList<Integer> actions = new ArrayList<>();
                    ArrayList<Integer> weights = new ArrayList<>();

                    actions.add(1); //攻撃
                    weights.add(30);

                    if (!charged) {
                        actions.add(2); //蓄える
                        weights.add(20);
                    }

                    if (enemyHp <= 60) {
                        actions.add(3); //雑草を食べる
                        weights.add(15);
                    }
                    if (!weakened) {
                        actions.add(4); //かわいこぶる
                        weights.add(15);
                    }

                    actions.add(5); //ぷにぷに
                    weights.add(20);

                    int totalWeight = 0;

                    for (int weight : weights) {
                        totalWeight += weight;
                    }

                    int roll = random.nextInt(totalWeight);

                    int slimeAction = 0;

                    for (int i = 0; i < actions.size(); i++) {
                        roll -= weights.get(i);

                        if (roll < 0) {
                            slimeAction = actions.get(i);
                            break;
                        }
                    }

                        if (slimeAction ==1) {
                        int damage = random.nextInt(5, 11);

                        if (defending) {
                            damage = (int) Math.round(damage * 0.5);
                        }
                        if (charged) {
                            damage = damage * 2;
                            charged = false;
                        }

                        playerHp = Math.max(0, playerHp - damage);

                        System.out.println("スライムの攻撃！");
                        Thread.sleep(1500);
                        System.out.println("勇者に" + damage + "ダメージ！");
                        Thread.sleep(1500);
                        System.out.println("勇者 Hp:" + playerHp);
                        Thread.sleep(1500);

                    } else if (slimeAction == 2) {
                        System.out.println("スライムは力を蓄えている..!");
                        Thread.sleep(1500);

                        charged = true;

                    } else if (slimeAction == 3) {
                        int beforeHp = enemyHp;
                        enemyHp = Math.min(80,enemyHp + 10);
                        int healedHp = enemyHp - beforeHp;

                        System.out.println("スライムは雑草を食べた！");
                        Thread.sleep(1500);
                        System.out.println("スライムのHPが" + healedHp + "回復した！");
                        Thread.sleep(1500);
                        System.out.println("スライム HP:" + enemyHp);
                        Thread.sleep(1500);

                    } else if (slimeAction == 4) {
                        System.out.println("スライムはかわいこぶっている..!");
                        Thread.sleep(1500);
                         weakened = true;
                         weakenedTurns = 3;
                          System.out.println("勇者の攻撃力が下がった！");
                          Thread.sleep(1500);

                    } else if (slimeAction == 5) {
                        System.out.println("スライムはぷにぷにしている...");
                        Thread.sleep(1500);

                        if (random.nextInt(5) == 0) {
                            System.out.println("ぷに.....ぷにぷにぷにぷにぷに!");
                            Thread.sleep(1500);

                            playerHp = 0;
                             System.out.println("勇者は9999ダメージを受けた！");
                             Thread.sleep(1500);

                             System.out.println("勇者 HP:" + playerHp);
                             Thread.sleep(1500);
                        }
                    }

                    defending = false;
                }

                if (burned && burnTurns > 0) {
                    enemyHp = Math.max(0,enemyHp - burnDamage);
                    burnTurns--;

                    System.out.println();
                    System.out.println("スライムはやけどで" + burnDamage + "ダメージを受けた！");
                    Thread.sleep(1500);

                    System.out.println("スライム HP:" + enemyHp);

                    if (burnTurns <= 0) {
                        burned = false;
                        System.out.println();
                        System.out.println("スライムのやけどが治った！");
                        Thread.sleep(1500);
                    }
                }





                //身体強化のターン処理
                if (enhanced) {
                    enhanceTurns--;

                    if (enhanceTurns <= 0) {
                        enhanced = false;
                        System.out.println();
                        System.out.println("身体強化の効果が切れた！");
                        Thread.sleep(1500);
                    }
                }
                if (weakened) {
                    weakenedTurns--;

                    if (weakenedTurns <= 0) {
                        weakened = false;
                        System.out.println();
                        System.out.println("勇者の攻撃力ダウンの効果が切れた！");
                        Thread.sleep(1500);
                    }

                }

            }
            if (escaped) {
                System.out.println();
                System.out.println("戦闘を終了した！");

            } else if (enemyHp <= 0 && playerHp > 0) {
                System.out.println();
                System.out.println("スライムを倒した！");
                Thread.sleep(1500);
                System.out.println("勝利！");

            } else if (playerHp <= 0) {
                System.out.println();
                System.out.println("勇者は力尽きた...");
                Thread.sleep(1500);
                System.out.println("ゲームオーバー！");

            }
        }
    }
